<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the main app, signed with the same certificate, may bind this service. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="dev.zakocoder.app.permission.KERNEL"
        android:protectionLevel="signature" />

    <application
        android:hasCode="true"
        android:icon="@drawable/ic_kernel"
        android:label="@string/app_name"
        >

        <!-- Public activation has no privileged actions; the actual service stays signature protected. -->
        <activity
            android:name=".KernelActivationActivity"
            android:exported="true"
            android:theme="@style/KernelActivationTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KernelService"
            android:exported="true"
            android:permission="dev.zakocoder.app.permission.KERNEL" />

        <meta-data android:name="dev.zakocoder.app.kernel.MIN_MAIN_VERSION" android:value="${minMainVersion}" />
        <meta-data android:name="dev.zakocoder.app.kernel.CONTRACT_VERSION" android:value="1" />
    </application>
</manifest>
