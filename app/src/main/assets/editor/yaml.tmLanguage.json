{
  "name": "yaml",
  "scopeName": "source.zako.yaml",
  "patterns": [
    {
      "name": "comment.line",
      "match": "#.*$"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "^[ \\t]*(?:---|\\.\\.\\.)(?:\\s|$)|[A-Za-z_][\\w.-]*(?=\\s*:)"
    },
    {
      "name": "keyword.control",
      "match": "(?i)\\b(?:true|false|null|yes|no|on|off)\\b"
    },
    {
      "name": "constant.character.escape",
      "match": "[&*][A-Za-z_][\\w.-]*"
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?)\\b"
    }
  ]
}
