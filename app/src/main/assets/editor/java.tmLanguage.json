{
  "name": "java",
  "scopeName": "source.zako.java",
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:class|interface|enum|package|import|public|private|protected|static|final|void|int|long|double|float|boolean|char|byte|short|new|return|if|else|for|while|try|catch|throw|throws|extends|implements|null|true|false|this|super|synchronized|abstract)\\b"
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?)\\b"
    }
  ]
}
