{
  "name": "toml",
  "scopeName": "source.zako.toml",
  "patterns": [
    {
      "name": "comment.line",
      "match": "#.*$"
    },
    {
      "name": "string.quoted",
      "begin": "\"\"\"",
      "end": "\"\"\""
    },
    {
      "name": "string.quoted",
      "begin": "'''",
      "end": "'''"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "^\\s*\\[\\[?[^\\]\\r\\n]+\\]\\]?|[A-Za-z_][\\w.-]*(?=\\s*=)"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?)\\b"
    }
  ]
}
