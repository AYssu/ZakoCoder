    <string name="setup_purpose_title">你想在手机上做什么？</string>
    <string name="setup_purpose_hint">选择主要用途，我们为你准备对应的工具建议。之后随时可以调整。</string>
    <string name="setup_use_web">网页与前端</string>
    <string name="setup_use_web_hint">Node.js、npm 与 Git，适合网页和前端工程。</string>
    <string name="setup_use_scripts">脚本与自动化</string>
    <string name="setup_use_scripts_hint">Python 与 Git，适合脚本、数据处理和小工具。</string>
    <string name="setup_use_android">Android 开发</string>
    <string name="setup_use_android_hint">JDK、Android SDK 与 Git，设备支持范围以工具包说明为准。</string>
    <string name="setup_use_native">本机与命令行开发</string>
    <string name="setup_use_native_hint">C/C++ 基础工具与 Git，也可以按需选择 Go 或 Rust。</string>
    <string name="setup_use_general">先体验 AI 助手</string>
    <string name="setup_use_general_hint">保持轻量，开发工具之后再安装。</string>
    <string name="setup_purpose_no_install">这里只生成建议，不会自动下载或安装软件。</string>
    <string name="setup_environment_title">准备 Linux 开发环境</string>
    <string name="setup_environment_hint">Ubuntu 为终端和开发工具提供运行环境。你也可以先跳过，之后从环境页安装。</string>
    <string name="setup_source_tsinghua">适合中国大陆网络，作为 Ubuntu 内的软件安装源。</string>
    <string name="setup_source_official">使用 Ubuntu 官方软件源。</string>
    <string name="setup_source_scope">软件源只影响 Ubuntu 内的软件安装，不会更换首次安装的系统镜像下载地址。Full 版使用随应用提供的本地镜像。</string>
    <string name="setup_installed">已安装</string>
    <string name="setup_not_installed">尚未安装</string>
    <string name="setup_model_title">连接你的 AI 服务</string>
    <string name="setup_model_hint">使用你自己的服务商、模型和密钥。保存后可以手动测试连接，也可以稍后配置。</string>
    <string name="setup_model_saved">已保存的模型配置</string>
    <string name="setup_model_count">%1$d 个配置</string>
    <string name="setup_configure_models">配置 AI 服务商</string>
    <string name="setup_model_private">密钥在本机加密保存。实际对话会将相关内容发送到你选择的模型服务。</string>
    <string name="setup_skills_title">让助手按你的习惯工作</string>
    <string name="setup_skills_hint">Skill 是给助手的工作指导。以下为内置推荐，帮助控制修改范围、查明问题并验证结果。</string>
    <string name="setup_skills_scope">Skill 配置在所有工作区和对话中共用，修改将在下一次任务中生效，也可导入自己的 Skill。</string>
    <string name="setup_manage_skills">管理全局 Skill</string>
    <string name="setup_packages_title">选择需要的工具包</string>
    <string name="setup_packages_hint">根据用途预选基础工具，你可以增减。点击安装后会先展示安装内容，需要许可的工具仍须单独确认。</string>
    <string name="setup_packages_need_environment">安装工具包前需先完成 Ubuntu 安装。现在可以继续，稍后从环境页安装。</string>
    <string name="setup_permissions_title">集中管理应用权限</string>
    <string name="setup_permissions_hint">按用途逐项选择。不会一次性请求全部权限，也不会因为拒绝而阻止进入应用。</string>
    <string name="setup_permissions_system">文件、通知与应用安装</string>
    <string name="setup_permissions_system_hint">分别用于绑定本地源码、显示运行状态，以及安装你构建的 APK。</string>
    <string name="setup_permissions_optional">悬浮窗、屏幕操作与后台运行</string>
    <string name="setup_permissions_optional_hint">仅在相关场景启用；无障碍与 Root 是可选访问方式，不是使用助手的前提。</string>
    <string name="setup_manage_permissions">逐项查看和授权</string>
    <string name="setup_permissions_no_force">系统权限需要你亲自确认。进入后仍可在设置中的权限管理调整；项目工具审批在选择工作区后单独配置。</string>
    <string name="setup_ready_title">从一次对话开始</string>
    <string name="setup_ready_hint">工作台以 AI 对话为中心。选择或创建工作区，让对话、文件和终端围绕同一份代码工作。</string>
    <string name="setup_summary_environment">Ubuntu 开发环境</string>
    <string name="setup_summary_models">AI 服务</string>
    <string name="setup_finish_hint">未配置的内容不会丢失入口。你随时可以在环境与设置中继续完善。</string>
    <string name="setup_preparing_workspace">正在准备工作台…</string>
    <string name="setup_packages_busy">当前操作进行中，请等待完成或取消后再安装工具包。</string>
    <string name="setup_packages_checking">正在检测已安装工具，检测完成后即可安装所选工具包。</string>
    <string name="setup_packages_none_selected">尚未选择工具包。你可以按需勾选，也可以稍后安装。</string>
    <string name="setup_packages_no_pending">所选工具包无需重复安装。你可以继续，也可以选择其他工具包。</string>
</resources>
