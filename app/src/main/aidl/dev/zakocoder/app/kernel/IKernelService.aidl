package dev.zakocoder.app.kernel;

/**
 * Stable contract between the main app and the optional kernel plugin (v1).
 *
 * The main app verifies the plugin package, signing certificate and version before binding; the
 * plugin's service is protected by a signature-level permission. The config passed to [start] is a
 * self-contained Xray JSON document generated by the app; the plugin only writes it to its private
 * cache, starts the packaged executable and waits for the loopback SOCKS inbound.
 */
interface IKernelService {
    /**
     * Starts one kernel. Returns a JSON object:
     * `{"ok":true,"port":<port>,"error":""}` or `{"ok":false,"port":0,"error":"<category>"}`.
     * Replaces any previous kernel.
     */
    String start(String configJson, int port, String socksUser, String socksPass, String nodeId, String nodeName);

    /** Stops the kernel and removes the plaintext config. Idempotent. */
    void stop();

    /** JSON snapshot: `{"state":"stopped|running|failed","port":<port>,"contractVersion":1}`. */
    String status();

    int contractVersion();
}
